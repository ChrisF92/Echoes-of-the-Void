.skill-tree-modal {
  width: 96%;
  max-width: 1440px;
  min-width: 320px;
  height: 92%;
  min-height: 620px;
  margin: 12px;
  padding: 20px 24px;
  flex-direction: column;
  background-color: rgba(10, 14, 28, 0.96);
  border-radius: 16px;
  border-width: 1px;
  border-color: rgba(109, 162, 255, 0.35);
  color: #f4f6ff;
  box-shadow: 0 18px 54px rgba(6, 10, 20, 0.7);
}

.skill-tree-modal__header {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 16px;
}

.skill-tree-modal__title {
  font-size: 24px;
  -unity-font-style: bold;
  color: rgba(244, 246, 255, 0.95);
  flex-grow: 1;
}

.skill-tree-modal__points {
  font-size: 15px;
  color: rgba(244, 246, 255, 0.8);
  min-width: 72px;
  -unity-text-align: middle-right;
}

.skill-tree-modal__close {
  min-width: 96px;
  align-self: flex-start;
}

.skill-tree-modal__body {
  flex-direction: column;
  flex-grow: 1;
  min-height: 0;
}

.skill-tree-modal__scroll {
  flex-grow: 1;
  min-height: 0;
  border-radius: 12px;
  border-width: 1px;
  border-color: rgba(109, 162, 255, 0.22);
  background-color: rgba(14, 18, 34, 0.9);
  padding: 18px 12px;
}

.skill-tree-modal__scroll > .unity-scroll-view__content-container {
  padding-right: 12px;
}

.skill-tree-modal__tiers {
  flex-direction: row;
  align-items: flex-start;
  gap: 18px;
}

.skill-tree-modal__empty {
  margin-top: 28px;
  font-size: 16px;
  color: rgba(244, 246, 255, 0.7);
  -unity-text-align: middle-center;
}

.skill-tree-tier {
  flex-direction: column;
  min-width: 220px;
  max-width: 260px;
}

.skill-tree-tier__title {
  font-size: 15px;
  text-transform: uppercase;
  letter-spacing: 1.1px;
  color: rgba(244, 246, 255, 0.6);
  margin-bottom: 10px;
}

.skill-tree-tier__nodes {
  flex-direction: column;
  gap: 12px;
}

.skill-tree-node {
  flex-direction: column;
  gap: 6px;
  padding: 14px 16px;
  border-radius: 12px;
  border-width: 2px;
  border-color: rgba(109, 162, 255, 0.18);
  background-color: rgba(8, 12, 24, 0.85);
  color: rgba(244, 246, 255, 0.85);
  transition: background-color 0.12s ease, border-color 0.12s ease, transform 0.12s ease;
  min-height: 96px;
}

.skill-tree-node__name {
  font-size: 17px;
  -unity-font-style: bold;
  color: rgba(244, 246, 255, 0.92);
}

.skill-tree-node__cost {
  font-size: 13px;
  color: rgba(244, 246, 255, 0.68);
}

.skill-tree-node__cost--insufficient {
  color: #ffb76b;
}

.skill-tree-node__status {
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 1.4px;
  color: rgba(244, 246, 255, 0.48);
}

.skill-tree-node--locked {
  background-color: rgba(6, 10, 20, 0.8);
  border-color: rgba(109, 162, 255, 0.12);
  color: rgba(244, 246, 255, 0.45);
}

.skill-tree-node--locked .skill-tree-node__name {
  color: rgba(244, 246, 255, 0.55);
}

.skill-tree-node--unlockable {
  background-color: rgba(26, 22, 12, 0.9);
  border-color: rgba(255, 212, 96, 0.85);
  color: rgba(255, 230, 160, 0.9);
  box-shadow: 0 0 12px rgba(255, 212, 96, 0.25);
}

.skill-tree-node--unlockable .skill-tree-node__name {
  color: #ffe79b;
}

.skill-tree-node--unlocked {
  background-color: rgba(12, 28, 22, 0.94);
  border-color: rgba(92, 226, 175, 0.95);
  color: rgba(214, 255, 238, 0.9);
  box-shadow: 0 0 14px rgba(92, 226, 175, 0.3);
}

.skill-tree-node--unlocked .skill-tree-node__name {
  color: #d8ffe8;
}

.skill-tree-node--needs-points {
  border-style: dashed;
  border-color: rgba(255, 212, 96, 0.7);
  background-color: rgba(26, 22, 12, 0.82);
}

.skill-tree-node--selected {
  transform: translateY(-2px);
  box-shadow: 0 14px 28px rgba(6, 10, 20, 0.45);
  border-width: 2px;
  border-color: rgba(129, 178, 255, 0.9);
}

@media screen and (max-width: 720px) {
  .skill-tree-modal {
    width: 98%;
    margin: 8px;
    padding: 18px;
    min-height: 540px;
  }

  .skill-tree-modal__title {
    font-size: 20px;
  }

  .skill-tree-tier {
    min-width: 180px;
  }

  .skill-tree-node {
    min-height: 88px;
    padding: 12px 14px;
  }
}
