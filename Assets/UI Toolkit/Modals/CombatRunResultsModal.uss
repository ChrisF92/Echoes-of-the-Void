.combat-run-results {
  padding: 28px;
  background-color: rgba(10, 16, 30, 0.96);
  border-radius: 12px;
  border-width: 1px;
  border-color: rgba(109, 162, 255, 0.35);
  min-width: 420px;
  max-width: 620px;
  flex-direction: column;
  color: #f4f6ff;
}

.results-title {
  font-size: 26px;
  -unity-font-style: bold;
  color: rgba(244, 246, 255, 0.95);
  margin-bottom: 8px;
}

.results-summary {
  color: rgba(173, 185, 222, 0.92);
  font-size: 16px;
  margin-bottom: 16px;
}

.results-stats {
  flex-direction: row;
  margin-bottom: 16px;
}

.results-stat {
  background-color: rgba(16, 22, 36, 0.78);
  border-radius: 10px;
  border-width: 1px;
  border-color: rgba(109, 162, 255, 0.2);
  padding: 10px 14px;
  font-size: 15px;
  color: rgba(244, 246, 255, 0.9);
  margin-right: 12px;
}

#results-currency {
  margin-right: 0;
}

.results-section-title {
  font-size: 18px;
  -unity-font-style: bold;
  color: rgba(244, 246, 255, 0.9);
  margin-top: 8px;
  margin-bottom: 8px;
}

.results-list {
  height: 160px;
  border-width: 1px;
  border-color: rgba(109, 162, 255, 0.2);
  border-radius: 10px;
  background-color: rgba(8, 12, 24, 0.68);
  padding: 4px;
  margin-bottom: 12px;
}

.results-list > .unity-list-view__item {
  padding: 10px 12px;
  font-size: 15px;
  color: rgba(244, 246, 255, 0.88);
}

.results-list > .unity-list-view__item.unity-selected {
  background-color: rgba(66, 139, 255, 0.2);
  color: #f4f6ff;
}

.results-empty {
  color: rgba(173, 185, 222, 0.8);
  font-size: 14px;
  display: none;
  margin-top: 8px;
  margin-bottom: 12px;
}

.results-confirm-button {
  align-self: flex-end;
  padding: 10px 24px;
  background-color: rgba(66, 139, 255, 0.95);
  color: #0b1324;
  -unity-font-style: bold;
  border-radius: 10px;
  font-size: 16px;
  border-width: 0;
  margin-top: 12px;
}

.results-confirm-button:disabled {
  background-color: rgba(66, 139, 255, 0.4);
  color: rgba(11, 19, 36, 0.6);
}
