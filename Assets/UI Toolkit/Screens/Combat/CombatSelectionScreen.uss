.combat-selection-screen {
  flex-grow: 1;
  flex-direction: column;
  width: 100%;
  height: 100%;
  min-height: 100%;
  padding: 32px;
  position: relative;
  background-color: rgba(10, 16, 30, 0.96);
  color: #f4f6ff;
}

.combat-selection-panel {
  margin-bottom: 24px;
  flex-direction: column;
  flex: 1 1 auto;
  padding: 24px;
  border-radius: 12px;
  border-width: 1px;
  border-color: rgba(109, 162, 255, 0.28);
  background-color: rgba(16, 22, 36, 0.84);
}

.combat-selection-title {
  font-size: 28px;
  -unity-font-style: bold;
  margin-bottom: 16px;
  color: rgba(244, 246, 255, 0.95);
}

.combat-selection-body {
  flex-direction: row;
  flex: 1 1 auto;
  align-items: stretch;
}

.combat-run-list {
  flex: 0 0 320px;
  max-width: 360px;
  min-width: 280px;
  height: 100%;
  border-radius: 12px;
  border-width: 1px;
  border-color: rgba(109, 162, 255, 0.18);
  background-color: rgba(8, 12, 24, 0.72);
  padding: 4px;
  margin-right: 20px;
}

#combat-run-list > .unity-list-view__item {
  padding: 12px 14px;
  font-size: 16px;
  color: rgba(244, 246, 255, 0.9);
}

#combat-run-list > .unity-list-view__item.unity-selected {
  background-color: rgba(66, 139, 255, 0.2);
  color: #f4f6ff;
}

.combat-run-details {
  flex: 1 1 0;
  min-width: 0;
  flex-direction: column;
  padding: 24px;
  border-radius: 12px;
  border-width: 1px;
  border-color: rgba(109, 162, 255, 0.18);
  background-color: rgba(8, 12, 24, 0.6);
}

.combat-run-details-title {
  font-size: 24px;
  -unity-font-style: bold;
  color: rgba(244, 246, 255, 0.95);
  margin-bottom: 12px;
}

.combat-run-details-meta {
  color: rgba(173, 185, 222, 0.9);
  font-size: 15px;
  margin-bottom: 12px;
}

.combat-run-details-scroll {
  flex-grow: 1;
  border-radius: 10px;
  border-width: 1px;
  border-color: rgba(109, 162, 255, 0.12);
  background-color: rgba(10, 16, 30, 0.55);
  padding: 12px;
  margin-bottom: 12px;
}

.combat-run-details-description {
  white-space: normal;
  font-size: 15px;
  color: rgba(244, 246, 255, 0.85);
}

.combat-primary-button {
  -unity-font-style: bold;
  font-size: 16px;
  background-color: rgba(66, 139, 255, 0.95);
  color: #0b1324;
  padding: 10px 20px;
  border-radius: 8px;
  border-width: 0;
}

.combat-primary-button:disabled {
  background-color: rgba(66, 139, 255, 0.4);
  color: rgba(11, 19, 36, 0.6);
}

.combat-secondary-button {
  -unity-font-style: bold;
  font-size: 16px;
  padding: 10px 20px;
  border-radius: 8px;
  border-width: 1px;
  border-color: rgba(109, 162, 255, 0.25);
  background-color: rgba(244, 246, 255, 0.12);
  color: rgba(244, 246, 255, 0.88);
}

.combat-secondary-button:hover {
  background-color: rgba(244, 246, 255, 0.18);
}

.combat-secondary-button:disabled {
  color: rgba(244, 246, 255, 0.4);
  border-color: rgba(109, 162, 255, 0.12);
}

.combat-run-panel {
  display: none;
  flex-direction: column;
  padding: 24px;
  border-radius: 12px;
  border-width: 1px;
  border-color: rgba(109, 162, 255, 0.28);
  background-color: rgba(16, 22, 36, 0.84);
  margin-top: 24px;
}

.combat-run-header {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.combat-run-header-title {
  font-size: 22px;
  -unity-font-style: bold;
  color: rgba(244, 246, 255, 0.95);
}

.combat-run-header-meta {
  color: rgba(173, 185, 222, 0.9);
  font-size: 15px;
  margin-left: 12px;
}

.combat-run-floor-label {
  font-size: 20px;
  -unity-font-style: bold;
  color: rgba(244, 246, 255, 0.92);
  margin-bottom: 8px;
}

.combat-run-status-label {
  font-size: 15px;
  color: rgba(244, 246, 255, 0.85);
  min-height: 24px;
  margin-bottom: 12px;
}

.combat-run-controls {
  flex-direction: row;
}

#combat-next-floor-button {
  display: none;
}

#combat-next-floor-button {
  margin-right: 12px;
}

.combat-fade-overlay {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background-color: rgba(3, 7, 18, 0.82);
  display: none;
}
