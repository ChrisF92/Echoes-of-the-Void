<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
  <ui:Style src="Inventory.uss" />
  <ui:Template name="ConsumablesTabTemplate" src="InventoryConsumablesTab.uxml" />
  <ui:Template name="EquipmentTabTemplate" src="InventoryEquipmentTab.uxml" />
  <ui:Template name="KeyItemsTabTemplate" src="InventoryKeyItemsTab.uxml" />
  <ui:VisualElement name="inventory-root" class="inventory-screen">
    <ui:VisualElement name="inventory-header" class="inventory-header">
      <ui:Label name="inventory-title" class="inventory-title" text="Inventory" />
      <ui:Label name="inventory-summary" class="inventory-summary" text="0 / 0" />
      <ui:Button name="close-button" class="inventory-close-button" text="Close" />
    </ui:VisualElement>
    <ui:VisualElement name="inventory-body" class="inventory-body">
      <ui:VisualElement name="inventory-list-panel" class="inventory-list-panel">
        <ui:Label name="inventory-list-title" class="inventory-section-title" text="Inventory" />
        <ui:VisualElement name="inventory-tabs" class="inventory-tabs">
          <ui:Button name="tab-button-consumables" class="inventory-tab-button inventory-tab-button--active" text="Consumables" />
          <ui:Button name="tab-button-equipment" class="inventory-tab-button" text="Equipment" />
          <ui:Button name="tab-button-keyitems" class="inventory-tab-button" text="Key Items" />
        </ui:VisualElement>
        <ui:VisualElement name="inventory-tab-contents" class="inventory-tab-contents">
          <ui:Instance template="ConsumablesTabTemplate" />
          <ui:Instance template="EquipmentTabTemplate" />
          <ui:Instance template="KeyItemsTabTemplate" />
        </ui:VisualElement>
      </ui:VisualElement>
      <ui:VisualElement name="inventory-detail-panel" class="inventory-detail-panel">
        <ui:Label name="detail-title" class="inventory-detail-title" text="Select an item" />
        <ui:Label name="detail-quantity" class="inventory-detail-quantity" text="Quantity: 0" />
        <ui:ScrollView name="detail-scroll" class="inventory-detail-scroll" mode="Vertical">
          <ui:Label name="detail-description" class="inventory-detail-description" text="" />
        </ui:ScrollView>
      </ui:VisualElement>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
