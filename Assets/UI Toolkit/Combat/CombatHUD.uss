/* Root */
.combat-hud {
  flex-direction: column;
  justify-content: flex-start;
  align-items: stretch;
  width: 100%;
  height: 100%;
}

/* Grid fills available space above menu */
.combat-grid {
  flex-grow: 0;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  width: 100%;
  padding-top: 8px;
  padding-bottom: 8px;
}

.grid-cell {
  flex-grow: 0;
  flex-shrink: 0;
  flex-basis: 16.66%;
  max-width: 16.66%;
  height: 64px;
  border-left-width: 1px;
  border-right-width: 1px;
  border-top-width: 1px;
  border-bottom-width: 1px;
  border-color: #888888;
  background-color: rgba(32, 32, 32, 0.125);
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.grid-cell.highlighted {
  background-color: rgba(51, 170, 255, 0.33);
  border-color: #33AAFF;
}
/* Ally target highlight (blue) */
.grid-cell.highlighted-ally {
  background-color: rgba(51, 170, 255, 0.33);
  border-color: #33AAFF;
}
/* Enemy target highlight (red) */
.grid-cell.highlighted-enemy {
  background-color: rgba(255, 80, 80, 0.35);
  border-color: #FF5050;
}

/* Bottom action bar */
.combat-menu {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding-left: 8px;
  padding-right: 8px;
  padding-top: 6px;
  padding-bottom: 6px;
  background-color: rgba(34, 34, 34, 0.8);
}

.combat-button {
  flex-grow: 1;
  height: 36px;
  margin-left: 4px;
  margin-right: 4px;
  padding-left: 8px;
  padding-right: 8px;
}

/* Overlays above menu */
.item-list,
.skill-list {
  position: absolute;
  left: 8px;
  right: 8px;
  bottom: 56px; /* above menu */
  height: 160px;
  display: none;
  border-left-width: 1px;
  border-right-width: 1px;
  border-top-width: 1px;
  border-bottom-width: 1px;
  border-color: #666666;
  background-color: rgba(30, 30, 30, 0.8);
}

/* Two side 3x3 grids */
.side-grid {
  flex-direction: row;
  flex-wrap: wrap;
  width: 40%;
  max-width: 480px;
}

.enemy-grid {
  margin-left: 24px;
}

.side-grid .grid-cell {
  flex-grow: 0;
  flex-shrink: 0;
  flex-basis: 33.33%;
  max-width: 33.33%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

/* Visual gap between player and enemy halves */
.side-gap {
  margin-left: 12px;
  border-left-width: 2px;
  border-left-color: #777777;
}

.cell-name {
  -unity-font-style: bold;
  font-size: 12px;
  color: #eeeeee;
  -unity-text-align: middle-center;
}

.cell-hp {
  font-size: 11px;
  color: #dddddd;
  -unity-text-align: middle-center;
}

/* Simple HP bar under labels */
.hp-bar {
  width: 80%;
  height: 6px;
  margin-top: 2px;
  border-left-width: 1px;
  border-right-width: 1px;
  border-top-width: 1px;
  border-bottom-width: 1px;
  border-color: rgba(255,255,255,0.25);
  background-color: rgba(0, 0, 0, 0.35);
}
.hp-fill {
  height: 100%;
  background-color: #3CB371; /* mediumseagreen */
  width: 0%;
}
