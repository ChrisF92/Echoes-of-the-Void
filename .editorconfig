# EditorConfig enforcing Google C# style
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
continuation_indent_size = 4
trim_trailing_whitespace = true

[*.{cs,csx}]
max_line_length = 100
csharp_new_line_before_open_brace = none
csharp_new_line_before_else = false
csharp_new_line_before_catch = false
csharp_new_line_before_finally = false
csharp_new_line_between_query_expression_clauses = true
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
csharp_prefer_braces = true:warning
csharp_style_allow_embedded_statements_on_same_line = false:warning
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_labels = one_less_than_current
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_after_comma = true
csharp_space_before_comma = false
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_declaration_empty_parameter_list_parentheses = false
csharp_space_between_method_call_empty_parameter_list_parentheses = false
csharp_space_before_dot = false
csharp_space_around_binary_operators = before_and_after
csharp_style_namespace_declarations = block_scoped:warning
dotnet_style_namespace_match_folder = false:warning
csharp_preferred_modifier_order = public,protected,internal,private,new,abstract,virtual,override,sealed,static,readonly,extern,unsafe,volatile,async:warning
csharp_style_allow_multiple_attributes_per_line = false:warning
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Naming styles

dotnet_naming_rule.interface_should_be_i_prefixed.priority = 1
dotnet_naming_rule.interface_should_be_i_prefixed.symbols = interfaces
dotnet_naming_rule.interface_should_be_i_prefixed.style = interface_prefix_style
dotnet_naming_rule.interface_should_be_i_prefixed.severity = warning

dotnet_naming_rule.types_should_be_pascal_case.priority = 2
dotnet_naming_rule.types_should_be_pascal_case.symbols = types
dotnet_naming_rule.types_should_be_pascal_case.style = pascal_case_style
dotnet_naming_rule.types_should_be_pascal_case.severity = warning

dotnet_naming_rule.methods_should_be_pascal_case.priority = 2
dotnet_naming_rule.methods_should_be_pascal_case.symbols = methods
dotnet_naming_rule.methods_should_be_pascal_case.style = pascal_case_style
dotnet_naming_rule.methods_should_be_pascal_case.severity = warning

dotnet_naming_rule.namespaces_should_be_pascal_case.priority = 2
dotnet_naming_rule.namespaces_should_be_pascal_case.symbols = namespaces
dotnet_naming_rule.namespaces_should_be_pascal_case.style = pascal_case_style
dotnet_naming_rule.namespaces_should_be_pascal_case.severity = warning

dotnet_naming_rule.public_members_should_be_pascal_case.priority = 3
dotnet_naming_rule.public_members_should_be_pascal_case.symbols = public_members
dotnet_naming_rule.public_members_should_be_pascal_case.style = pascal_case_style
dotnet_naming_rule.public_members_should_be_pascal_case.severity = warning

dotnet_naming_rule.non_public_fields_and_properties_should_be_underscored.priority = 1
dotnet_naming_rule.non_public_fields_and_properties_should_be_underscored.symbols = non_public_fields_and_properties
dotnet_naming_rule.non_public_fields_and_properties_should_be_underscored.style = underscore_camel_case_style
dotnet_naming_rule.non_public_fields_and_properties_should_be_underscored.severity = warning

dotnet_naming_rule.locals_and_parameters_should_be_camel_case.priority = 3
dotnet_naming_rule.locals_and_parameters_should_be_camel_case.symbols = locals_and_parameters
dotnet_naming_rule.locals_and_parameters_should_be_camel_case.style = camel_case_style
dotnet_naming_rule.locals_and_parameters_should_be_camel_case.severity = warning

# Symbol groups

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *
dotnet_naming_symbols.interfaces.required_modifiers = 

dotnet_naming_symbols.types.applicable_kinds = class,struct,enum,delegate
dotnet_naming_symbols.types.applicable_accessibilities = *
dotnet_naming_symbols.types.required_modifiers = 

dotnet_naming_symbols.methods.applicable_kinds = method,local_function
dotnet_naming_symbols.methods.applicable_accessibilities = *
dotnet_naming_symbols.methods.required_modifiers = 

dotnet_naming_symbols.namespaces.applicable_kinds = namespace
dotnet_naming_symbols.namespaces.applicable_accessibilities = *
dotnet_naming_symbols.namespaces.required_modifiers = 

dotnet_naming_symbols.public_members.applicable_kinds = field,property,event
dotnet_naming_symbols.public_members.applicable_accessibilities = public
dotnet_naming_symbols.public_members.required_modifiers = 

dotnet_naming_symbols.non_public_fields_and_properties.applicable_kinds = field,property
dotnet_naming_symbols.non_public_fields_and_properties.applicable_accessibilities = private,protected,internal,protected_internal,private_protected
dotnet_naming_symbols.non_public_fields_and_properties.required_modifiers = 

dotnet_naming_symbols.locals_and_parameters.applicable_kinds = parameter,local
dotnet_naming_symbols.locals_and_parameters.applicable_accessibilities = *
dotnet_naming_symbols.locals_and_parameters.required_modifiers = 

# Naming style definitions

dotnet_naming_style.pascal_case_style.capitalization = pascal_case
dotnet_naming_style.pascal_case_style.required_prefix = 
dotnet_naming_style.pascal_case_style.required_suffix = 

dotnet_naming_style.camel_case_style.capitalization = camel_case
dotnet_naming_style.camel_case_style.required_prefix = 
dotnet_naming_style.camel_case_style.required_suffix = 

dotnet_naming_style.underscore_camel_case_style.capitalization = camel_case
dotnet_naming_style.underscore_camel_case_style.required_prefix = _
dotnet_naming_style.underscore_camel_case_style.required_suffix = 

dotnet_naming_style.interface_prefix_style.capitalization = pascal_case
dotnet_naming_style.interface_prefix_style.required_prefix = I
dotnet_naming_style.interface_prefix_style.required_suffix = 
